# Base URL of the UI application under test (SauceDemo)
BASE_URL=https://www.saucedemo.com

# Base URL of the API under test (JSONPlaceholder — free, no API key required)
API_BASE_URL=https://jsonplaceholder.typicode.com

# Timeout (ms) applied to every API request made via the apiClient fixture
API_TIMEOUT_MS=10000

# Shared password for all SauceDemo demo accounts
SAUCE_PASSWORD=secret_sauce
