{
  "name": "playwright-qa-assignment",
  "version": "1.0.0",
  "description": "Playwright + TypeScript QA automation framework covering UI, API, cross-browser, mobile, performance, and accessibility testing.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=\"Mobile Safari - iPhone 14\" --project=\"Mobile Chrome - Pixel 7\"",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --project=accessibility",
    "test:perf": "playwright test --project=performance",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --single-file --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
